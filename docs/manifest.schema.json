{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amazepr.dev/schemas/change-manifest-0.1.schema.json",
  "title": "Change Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "protocol_version",
    "producer",
    "change",
    "workflow",
    "files",
    "verification",
    "risks",
    "agent_notes"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "0.1"
    },
    "producer": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "title",
        "intent",
        "scope",
        "non_goals"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "workflow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "step",
          "title",
          "description",
          "files"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "end_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "label": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "path",
          "role",
          "reason",
          "review_notes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "added",
              "modified",
              "deleted",
              "moved"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "review_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "commands",
        "manual_checks",
        "known_gaps"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "command",
              "status"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "not_run",
                  "unknown"
                ]
              },
              "evidence": {
                "type": "string"
              }
            }
          }
        },
        "manual_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "area",
          "risk",
          "mitigation"
        ],
        "properties": {
          "area": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "agent_notes": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "assumptions",
        "limitations"
      ],
      "properties": {
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
